# Airflow Environment Configuration
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_ROLE=Admin
AIRFLOW_ADMIN_EMAIL=admin@realtor-pipeline.local
AIRFLOW_ADMIN_PASS=AdminPassword123!
AIRFLOW_UID=50000

# Webserver
AIRFLOW_WEB_PORT=8080
AIRFLOW_PUBLIC_URL=http://localhost:8080
AIRFLOW_CORE_EXECUTOR=LocalExecutor

# Postgres
PG_USERNAME=airflow
PG_PASSWORD=airflow_secret_pass
PG_DATABASE=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASS=airflow_secret_pass

# FlareSolverr Cloudflare Bypass
FLARESOLVERR_PORT=8191
FLARESOLVERR_URL=http://flaresolverr:8191/v1
FLARESOLVERR_LOG_LEVEL=info
APP_PUID=1000
APP_PGID=1000
HOST_TZ=America/Vancouver
PREFER_FLARESOLVERR=true

# Pipeline Storage & Scraper Controls
SQLITE_DB_PATH=/opt/airflow/data/real_estate.db
CSV_OUTPUT_PATH=/opt/airflow/data/real_estate_listings.csv
RATE_LIMIT_DELAY_SECONDS=2.0
MAX_BACKOFF_RETRIES=5
MAX_PAGES_PER_CITY=5
_PIP_ADDITIONAL_REQUIREMENTS=""
